---
import Base from '../layouts/Base.astro';
import TitleCard from '../components/TitleCard.astro';
import SiteMenu from '../components/SiteMenu.astro';
import Hero from '../components/Hero.astro';
import CursorTrail from '../components/CursorTrail.astro';
import { frontmatter as copy } from '../../content/landing.md';
---
<Base title={copy.titleCard.name}>
  <TitleCard {...copy.titleCard} />
  <CursorTrail />
  <SiteMenu name={copy.titleCard.name} items={copy.menu} />
  <main>
    <Hero greeting={copy.greeting} hero={copy.hero} map={copy.map} />

    <!-- Stub stations. Phase 3 replaces #desk with the 3D desk and wall scene. -->
    <section id="desk" class="stub" data-station="desk"><p>{copy.stubs.desk}</p></section>
    <section id="work" class="stub" data-station="work"><p>{copy.stubs.work}</p></section>
    <section id="personal" class="stub" data-station="personal"><p>{copy.stubs.personal}</p></section>
    <section id="contact" class="stub" data-station="contact"><p>{copy.stubs.contact}</p></section>
  </main>
</Base>

<style>
  .stub {
    height: 100vh; min-height: 640px; scroll-snap-align: start;
    display: grid; place-items: center; border-top: 1px solid rgb(29 34 30 / 0.1);
  }
  .stub p { margin: 0; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); }
</style>
