---
// The ice axe opens to this: a shaded-relief map of Washington, styled after classic
// physical maps (elevation tints, hillshading, rivers, borders). Climbed peaks are clickable
// and open a rotating photo slideshow with a short story; next climbs are marked but not clickable.
//
// Real photos: drop them at src/assets/climbs/<peak id>-1.jpg, -2.jpg, ... (jpg or webp).
// They replace the placeholder slides with no code changes.
// Relief image: node scripts/make-relief.mjs src/assets/map/relief.webp
import relief from '../assets/map/relief.webp';
import { VW, VH, px, py, KM, RIVERS, CITIES, RAMP, smoothPath, type LonLat } from '../data/washington';

interface Peak { id: string; name: string; elevation: string; lat: number; lon: number; body?: string; next?: boolean; label?: 'below' | 'left' | 'right' }
interface Props { copy: { title: string; intro: string; back: string; mapBack: string; photoNote: string; nextLabel: string; legend: string; peaks: Peak[] } }
const { copy } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/climbs/*.{jpg,jpeg,webp,png}', { eager: true });
const photosFor = (id: string) =>
  Object.entries(photos)
    .filter(([p]) => p.split('/').pop()!.startsWith(`${id}-`))
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, m]) => m.default.src);

const peaks = copy.peaks.map((p) => ({ ...p, x: px(p.lon), y: py(p.lat), photos: p.next ? [] : photosFor(p.id) }));
const climbed = peaks.filter((p) => !p.next);

// Borders: the Canada line (dash-dot, through the Strait) and the Idaho / Oregon lines (dashed).
const intl: LonLat[] = [[-124.78, 48.47], [-124.0, 48.3], [-123.25, 48.24], [-123.12, 48.43], [-123.25, 48.7], [-123.0, 48.83], [-122.76, 49.0], [-116.6, 49.0]];
const stateLines: LonLat[][] = [[[-117.03, 49.0], [-117.03, 46.42]], [[-116.92, 46.0], [-118.98, 46.0]]];
const line = (pts: LonLat[]) => 'M' + pts.map(([lo, la]) => `${px(lo).toFixed(1)} ${py(la).toFixed(1)}`).join(' L');

const gridLat = [46, 47, 48, 49];
const gridLon = [-124, -123, -122, -121, -120, -119, -118, -117];

// Region and water names (geography, not copy).
const regions = [
  { t: 'Pacific Ocean', lon: -124.62, lat: 46.95, cls: 'water big', rot: -90 },
  { t: 'Strait of Juan de Fuca', lon: -123.95, lat: 48.24, cls: 'water', rot: -8 },
  { t: 'Puget Sound', lon: -122.48, lat: 47.42, cls: 'water', rot: -70 },
  { t: 'Olympic Mountains', lon: -123.62, lat: 47.62, cls: 'range', rot: 0 },
  { t: 'Cascade Range', lon: -120.88, lat: 47.35, cls: 'range big', rot: -80 },
  { t: 'Columbia Basin', lon: -118.85, lat: 47.05, cls: 'range big', rot: 0 },
  { t: 'Canada', lon: -119.8, lat: 49.08, cls: 'country', rot: 0 },
  { t: 'Oregon', lon: -120.2, lat: 45.55, cls: 'country', rot: 0 },
  { t: 'Idaho', lon: -116.82, lat: 47.3, cls: 'country', rot: -90 },
];

// Legend: elevation tints in feet.
const legend = [...RAMP].reverse().map(([m, c]) => ({ c, ft: Math.round((m * 3.28084) / 100) * 100 }));
const kmBar = KM * 50; // 50 km
const miBar = KM * 1.609 * 25; // 25 mi
---
<div class="climbs" role="dialog" aria-modal="true" aria-label={copy.title} hidden data-peaks={JSON.stringify(climbed)}>
  <header class="top">
    <div>
      <h2>{copy.title}</h2>
      <p class="intro">{copy.intro}</p>
    </div>
    <button type="button" class="back">{copy.back}</button>
  </header>

  <div class="map" style={`aspect-ratio: ${VW} / ${VH}`}>
    <img class="relief" src={relief.src} width={relief.width} height={relief.height} alt="" decoding="async" />
    <svg viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true">
      <g class="grid">
        {gridLat.map((lat) => <g><path d={`M0 ${py(lat)} H${VW}`} /><text x="12" y={py(lat) - 8}>{`${lat}°`}</text></g>)}
        {gridLon.map((lon) => <g><path d={`M${px(lon)} 0 V${VH}`} /><text x={px(lon) + 8} y={VH - 14}>{`${Math.abs(lon)}°`}</text></g>)}
      </g>
      <g class="rivers">{RIVERS.map((r) => <path d={smoothPath(r.pts, false)} />)}</g>
      <path class="border intl" d={line(intl)} />
      {stateLines.map((l) => <path class="border state" d={line(l)} />)}
      <g class="cities">
        {CITIES.map((c) => c.capital
          ? <g transform={`translate(${px(c.lon)} ${py(c.lat)})`}><path class="star" d="M0 -11 L3 -3 L11 -3 L4.5 2 L7 10 L0 5 L-7 10 L-4.5 2 L-11 -3 L-3 -3 Z" /><text x="14" y="5">{c.name}</text></g>
          : <g transform={`translate(${px(c.lon)} ${py(c.lat)})`}><circle r="5" /><text x="10" y="5">{c.name}</text></g>)}
      </g>
      <g class="regions">
        {regions.map((r) => <text class={r.cls} text-anchor="middle" transform={`translate(${px(r.lon)} ${py(r.lat)}) rotate(${r.rot})`}>{r.t}</text>)}
      </g>
      <g class="compass" transform={`translate(${VW - 80} 90)`}>
        <path d="M0 32 V-32 M-11 -14 L0 -34 L11 -14" />
        <text y="-44" text-anchor="middle">N</text>
      </g>
    </svg>

    <div class="legend" aria-hidden="true">
      <p>{copy.legend}</p>
      <ul>{[...legend].reverse().map((l, i) => <li><span style={`background:${l.c}`}></span><em>{i % 2 ? '\u00a0' : l.ft >= 1000 ? `${(l.ft / 1000).toFixed(1).replace('.0', '')}k` : l.ft}</em></li>)}</ul>
      <p class="unit">feet</p>
      <div class="bars">
        <div><i style={`width:${(kmBar / VW) * 100}cqw`}></i><b>50 km</b></div>
        <div><i style={`width:${(miBar / VW) * 100}cqw`}></i><b>25 mi</b></div>
      </div>
    </div>

    {peaks.map((p) => p.next ? (
      <div class="peak next" data-side={p.label ?? 'below'} style={`left: ${(p.x / VW) * 100}%; top: ${(p.y / VH) * 100}%`} aria-label={`${p.name}, ${copy.nextLabel}`}>
        <svg viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" class="ring" /><path d="M15 7 L22 20 H8 Z" /></svg>
        <span class="lbl"><span class="pname">{p.name}</span><span class="pelev">{p.elevation}</span><span class="tag">{copy.nextLabel}</span></span>
      </div>
    ) : (
      <button type="button" class="peak" data-id={p.id} data-side={p.label ?? 'below'} style={`left: ${(p.x / VW) * 100}%; top: ${(p.y / VH) * 100}%`}>
        <svg viewBox="0 0 20 18" aria-hidden="true"><path d="M10 1 L19 17 H1 Z" /></svg>
        <span class="lbl"><span class="pname">{p.name}</span><span class="pelev">{p.elevation}</span></span>
      </button>
    ))}
  </div>

  <section class="detail" hidden aria-live="polite">
    <div class="slides" aria-label="Photos">
      <div class="frames"></div>
      <div class="dots"></div>
    </div>
    <div class="story">
      <button type="button" class="map-back">← {copy.mapBack}</button>
      <h3></h3>
      <p class="elev"></p>
      <p class="text"></p>
    </div>
  </section>
  <p class="note" hidden>{copy.photoNote}</p>
</div>

<style>
  .climbs { position: fixed; inset: 0; z-index: 40; background: var(--color-bg); color: var(--color-ink); display: grid; grid-template-rows: auto 1fr; padding: 26px 4.2vw 30px; overflow: hidden; }
  .climbs[hidden] { display: none; }
  .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  h2 { margin: 0; font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(40px, 4vw, 72px); line-height: 0.85; color: var(--color-accent); }
  .intro { margin: 10px 0 0; max-width: 52ch; font-size: 13px; color: var(--color-muted); }
  .back, .map-back { font: 500 12px/1 var(--font-body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); background: none; border: 1.5px solid var(--color-accent); border-radius: 99px; padding: 10px 16px; cursor: pointer; }
  .map-back { border: 0; padding: 4px 0; margin-bottom: 22px; }
  .back:hover { background: var(--color-accent); color: var(--color-bg); }

  .map { position: relative; align-self: center; justify-self: center; width: min(100%, calc((100vh - 150px) * 1.54)); margin-top: 8px; border-radius: 6px; overflow: hidden; box-shadow: 0 0 0 1px rgb(29 34 30 / 0.15); container-type: inline-size; }
  .relief { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .grid path { stroke: #fff; stroke-width: 1.2; opacity: 0.55; }
  .grid text { font: 500 17px var(--font-body); fill: #4a4f4b; opacity: 0.8; }
  .rivers path { fill: none; stroke: #4f93c9; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
  .border { fill: none; stroke: #5b5f5c; stroke-width: 3; }
  .border.intl { stroke-dasharray: 22 8 4 8; }
  .border.state { stroke-dasharray: 16 9; }
  .cities circle { fill: #fff; stroke: #1d221e; stroke-width: 2.2; }
  .cities .star { fill: #1d221e; }
  .cities text { font: 500 19px var(--font-body); fill: #1d221e; paint-order: stroke; stroke: rgb(255 255 255 / 0.75); stroke-width: 4px; }
  .regions text { font-family: var(--font-body); font-style: italic; letter-spacing: 0.18em; text-transform: uppercase; paint-order: stroke; stroke-width: 4px; }
  .regions .water { fill: #2f6fa3; font-size: 19px; stroke: rgb(214 233 246 / 0.7); }
  .regions .water.big { font-size: 30px; letter-spacing: 0.4em; }
  .regions .range { fill: #3e3a33; font-size: 20px; stroke: rgb(255 255 255 / 0.55); }
  .regions .range.big { font-size: 28px; letter-spacing: 0.45em; }
  .regions .country { fill: #6b6a63; font-size: 26px; letter-spacing: 0.4em; font-style: normal; stroke: rgb(255 255 255 / 0.5); }
  .compass path { fill: none; stroke: #1d221e; stroke-width: 3; stroke-linecap: round; }
  .compass text { font: 500 22px var(--font-body); fill: #1d221e; }

  .legend {
    position: absolute; left: 1.2%; bottom: 2.2%; padding: 7px 9px 9px; background: rgb(255 255 255 / 0.86); border: 1px solid rgb(29 34 30 / 0.15);
    font-size: clamp(8px, 0.55vw, 10px); color: var(--color-ink);
  }
  .legend p { margin: 0 0 6px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .legend ul { list-style: none; margin: 0; padding: 0; display: flex; }
  .legend li { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
  .legend li span { width: clamp(13px, 1.15vw, 20px); height: 9px; }
  .legend li em { font-style: normal; font-size: 0.9em; }
  .legend .unit { margin: 4px 0 0; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--color-muted); }
  .bars { margin-top: 10px; display: grid; gap: 5px; }
  .bars div { display: flex; align-items: center; gap: 6px; }
  .bars i { display: block; height: 5px; background: linear-gradient(90deg, #1d221e 50%, #fff 50%); border: 1px solid #1d221e; }
  .bars b { font-weight: 500; }

  /* The marker sits on the summit; the label goes below, left, or right of it. */
  .peak {
    position: absolute; display: flex; align-items: center; gap: 6px;
    background: none; border: 0; padding: 4px; cursor: pointer; color: var(--color-ink); font: inherit; border-radius: 10px;
  }
  .peak[data-side='below'] { flex-direction: column; transform: translate(-50%, -16px); }
  .peak[data-side='right'] { flex-direction: row; transform: translate(-16px, -50%); }
  .peak[data-side='left'] { flex-direction: row-reverse; transform: translate(calc(-100% + 16px), -50%); }
  .lbl { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .peak[data-side='right'] .lbl { align-items: flex-start; }
  .peak[data-side='left'] .lbl { align-items: flex-end; }
  .peak svg { width: 24px; height: 22px; fill: #1d221e; stroke: #fff; stroke-width: 1.6; transition: transform 0.3s var(--ease-out); }
  .pname { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(15px, 1.25vw, 22px); line-height: 1; color: #1d221e; paint-order: stroke; -webkit-text-stroke: 0; text-shadow: 0 0 3px #fff, 0 0 3px #fff, 0 0 6px #fff; }
  .pelev { font-size: 11px; letter-spacing: 0.06em; color: #2b2e2b; text-shadow: 0 0 3px #fff, 0 0 3px #fff; }
  .peak:hover svg, .peak:focus-visible svg { transform: translateY(-3px) scale(1.18); fill: var(--color-accent); }
  .peak:hover .pname, .peak:focus-visible .pname { color: var(--color-accent); }

  /* Next climbs: hollow marker in a dashed ring, muted label, "Next up" tag. Not clickable. */
  .peak.next { cursor: default; }
  .peak.next svg { width: 30px; height: 26px; fill: none; stroke: var(--color-accent); stroke-width: 2; }
  .peak.next .ring { stroke-dasharray: 3 3; fill: rgb(255 255 255 / 0.55); }
  .peak.next .pname { color: var(--color-accent); opacity: 0.9; font-size: clamp(13px, 1.05vw, 18px); }
  .tag { margin-top: 2px; font-size: 9px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-bg); background: var(--color-accent); border-radius: 99px; padding: 3px 7px; }

  .detail {
    position: absolute; inset: 120px 4.2vw 30px; display: grid; grid-template-columns: 1.5fr 1fr; gap: 4vw; align-items: center;
    background: var(--color-bg); animation: rise 0.5s var(--ease-out) both;
  }
  .detail[hidden] { display: none; }
  .slides { position: relative; height: 100%; max-height: 72vh; display: grid; grid-template-rows: 1fr auto; gap: 14px; }
  .frames { position: relative; border-radius: 10px; overflow: hidden; background: #dcd9cd; }
  .frames :global(.frame) { position: absolute; inset: 0; opacity: 0; transition: opacity 0.7s var(--ease-out); }
  .frames :global(.frame.on) { opacity: 1; }
  .frames :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .frames :global(.ph) { width: 100%; height: 100%; display: grid; place-items: center; }
  .frames :global(.ph svg) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .frames :global(.ph span) { position: relative; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-bg); background: rgb(29 34 30 / 0.35); padding: 6px 10px; border-radius: 99px; }
  .dots { display: flex; gap: 8px; justify-content: center; }
  .dots :global(button) { width: 9px; height: 9px; border-radius: 50%; border: 0; padding: 0; background: rgb(29 34 30 / 0.2); cursor: pointer; }
  .dots :global(button[aria-current='true']) { background: var(--color-accent); }
  .story h3 { margin: 0; font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(48px, 5vw, 96px); line-height: 0.85; }
  .elev { margin: 12px 0 0; font-size: 13px; letter-spacing: 0.06em; color: var(--color-accent); }
  .text { margin: 22px 0 0; font-size: 14px; line-height: 1.65; max-width: 40ch; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  :global(html.reduced) .detail { animation: none; }
  :global(html.reduced) .frames :global(.frame) { transition: none; }
</style>

<script>
  import { rng } from '../scripts/contours';

  type Peak = { id: string; name: string; elevation: string; x: number; y: number; body: string; photos: string[] };
  const root = document.querySelector<HTMLElement>('.climbs')!;
  const peaks: Peak[] = JSON.parse(root.dataset.peaks!);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const note = root.querySelector('.note')!.textContent ?? '';

  // Placeholder slide: a mountain silhouette on a Pine gradient.
  const placeholder = (peak: Peak, n: number, total: number) => {
    const seed = rng(n * 31 + peak.id.length);
    const ridge = Array.from({ length: 9 }, (_, i) => `${i * 12.5} ${55 - seed() * 18 - (i === 4 ? 22 : 0)}`).join(' L');
    return `<div class="ph"><svg viewBox="0 0 100 62" preserveAspectRatio="xMidYMid slice">
      <defs><linearGradient id="g${peak.id}${n}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9fb8a6"/><stop offset="1" stop-color="#2f5d46"/></linearGradient></defs>
      <rect width="100" height="62" fill="url(#g${peak.id}${n})"/>
      <path d="M0 62 L0 ${55} L${ridge} L100 50 L100 62 Z" fill="#1f3d2f" opacity="0.85"/>
      <path d="M44 33 L50 22 L56 33 L52 31 L50 34 L48 31 Z" fill="#eeede5" opacity="0.9"/>
    </svg><span>${note} ${n + 1} / ${total}</span></div>`;
  };

  const detail = root.querySelector<HTMLElement>('.detail')!;
  const frames = detail.querySelector<HTMLElement>('.frames')!;
  const dots = detail.querySelector<HTMLElement>('.dots')!;
  let slide = 0, count = 0, timer = 0;

  const go = (i: number) => {
    slide = (i + count) % count;
    frames.querySelectorAll('.frame').forEach((f, k) => f.classList.toggle('on', k === slide));
    dots.querySelectorAll('button').forEach((d, k) => d.setAttribute('aria-current', String(k === slide)));
  };
  const auto = () => {
    clearInterval(timer);
    if (!reduced && count > 1) timer = window.setInterval(() => go(slide + 1), 3600);
  };

  function openPeak(p: Peak) {
    const srcs = p.photos.length ? p.photos : [null, null, null];
    count = srcs.length;
    frames.innerHTML = srcs.map((src, n) => `<div class="frame">${src ? `<img src="${src}" alt="${p.name}, photo ${n + 1}">` : placeholder(p, n, count)}</div>`).join('');
    dots.innerHTML = srcs.map((_, n) => `<button type="button" aria-label="Photo ${n + 1}"></button>`).join('');
    dots.querySelectorAll('button').forEach((d, n) => d.addEventListener('click', () => { go(n); auto(); }));
    detail.querySelector('h3')!.textContent = p.name;
    detail.querySelector('.elev')!.textContent = p.elevation;
    detail.querySelector('.text')!.textContent = p.body;
    detail.hidden = false;
    go(0);
    auto();
    detail.querySelector<HTMLElement>('.map-back')!.focus();
  }
  const closePeak = () => {
    clearInterval(timer);
    const id = detail.querySelector('h3')!.textContent;
    detail.hidden = true;
    [...root.querySelectorAll<HTMLElement>('.peak')].find((b) => b.querySelector('.pname')!.textContent === id)?.focus();
  };
  frames.addEventListener('mouseenter', () => clearInterval(timer));
  frames.addEventListener('mouseleave', auto);

  root.querySelectorAll<HTMLButtonElement>('.peak').forEach((b) => b.addEventListener('click', () => openPeak(peaks.find((p) => p.id === b.dataset.id)!)));
  detail.querySelector('.map-back')!.addEventListener('click', closePeak);

  let returnFocus: HTMLElement | null = null;
  const open = () => {
    returnFocus = document.activeElement as HTMLElement;
    root.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    if (!reduced) root.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 350, easing: 'ease-out' });
    root.querySelector<HTMLElement>('.peak')!.focus();
  };
  const close = async () => {
    clearInterval(timer);
    if (!reduced) await root.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 250, easing: 'ease-in' }).finished;
    root.hidden = true;
    detail.hidden = true;
    document.documentElement.style.overflow = '';
    returnFocus?.focus();
  };
  window.addEventListener('climbs:open', open);
  root.querySelector('.back')!.addEventListener('click', close);
  addEventListener('keydown', (e) => {
    if (root.hidden) return;
    if (e.key === 'Escape') {
      e.stopImmediatePropagation();
      if (!detail.hidden) closePeak();
      else close();
    }
    if (!detail.hidden && (e.key === 'ArrowRight' || e.key === 'ArrowLeft')) { go(slide + (e.key === 'ArrowRight' ? 1 : -1)); auto(); }
  }, true);
</script>
